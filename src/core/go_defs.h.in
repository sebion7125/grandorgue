#ifndef GODEFS_H
#define GODEFS_H

/* Timing / tracing logging macros
 * - LOG_TIMING(...) : general timing messages, enabled by -DGO_PROFILE_ODFLOAD
 * - LOG_GUI_GAP(...) : GUI gap tracer messages, enabled by -DGO_GUI_GAP_TRACER
 *
 * Both expand to no-ops when disabled to avoid changing control flow.
 */
#cmakedefine GO_PROFILE_ODFLOAD
#cmakedefine GO_GUI_GAP_TRACER

#ifdef GO_PROFILE_ODFLOAD
# define LOG_TIMING(...) wxLogMessage(__VA_ARGS__)
#else
# define LOG_TIMING(...) do{}while(0)
#endif

#ifdef GO_GUI_GAP_TRACER
# define LOG_GUI_GAP(...) LOG_TIMING(__VA_ARGS__)
#else
# define LOG_GUI_GAP(...) do{}while(0)
#endif


#define GITHUB_PROJECT "@GITHUB_PROJECT@"
#define APP_VERSION "v@FULL_VERSION@"
#define APP_WIN_VERSION @NUM_WIN_VERSION@

/* Value which is used to identify a valid cached organ data file. 
  It must be changed every time when the cache structure is modefied
*/
#define GRANDORGUE_CACHE_MAGIC 0x12341237

#cmakedefine HAVE_ATOMIC
#cmakedefine HAVE_MUTEX

#endif
